							"const": "FunctionDeclaration"
						},
						"name": {
							"type": "string"
						},
						"params": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"type": {
										"const": "Parameter"
									},
									"name": {
										"type": "string"
									},
									"dataType": {

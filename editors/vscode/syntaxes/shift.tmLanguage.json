{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Shift",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#magic-variables"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.shift",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.shift",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.shift",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.shift",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.shift",
          "match": "\\b(function|struct|return|transfer|share|try|catch|review|throw|if|else|while|for|in|to|break|skip|delete|and|or|xor|not|as|split|with|joined|contains|has|matches|search|replace|size of|type of|inspect|pack|unpack|error|alert|critical)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.shift",
          "match": "\\b(string|number|bool|null|any|nullable|list|map|shared)\\b"
        }
      ]
    },
    "magic-variables": {
      "patterns": [
        {
          "name": "variable.language.shift",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.shift",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  },
  "scopeName": "source.shift"
}

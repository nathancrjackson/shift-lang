{
  "name": "shift-lang",
  "displayName": "Shift Language Support",
  "description": "Syntax highlighting and language support for the Shift scripting language.",
  "version": "1.0.0",
  "publisher": "nathancrjackson",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "shift",
      "aliases": ["Shift", "shift"],
      "extensions": [".shift"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "shift",
      "scopeName": "source.shift",
      "path": "./syntaxes/shift.tmLanguage.json"
    }]
  }
}
